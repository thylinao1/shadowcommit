# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=container
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# --- Shadow Commit: the sealed network, the broker, and the agent's own memory ---------------
# Every turn of every agent runs inside a per-run `docker network create --internal` bridge whose
# only other member is a dual-homed broker container. The agent has no default route, so nothing
# leaves except through the broker, which allowlists destinations by exact host and port, holds
# write-like calls until the turn's commit decision, and terminates the model channel so the real
# provider key never enters the runtime.
SHADOW_CONFINE_NETWORK=true
# Exact host:port entries, comma separated. No wildcards and no suffix matching, because "anything
# ending in .npmjs.org" is defeated by any name an attacker can resolve. The model provider's own
# host is added automatically from ARK_BASE_URL. Leave empty for the default, which is the package
# registries the acceptance task needs: registry.npmjs.org, registry.yarnpkg.com, pypi.org and
# files.pythonhosted.org, all on 443.
SHADOW_EGRESS_ALLOWLIST=
# One allowlisted destination that always answers, so that a probe failing is not a usable signal
# to a payload that only fires when it believes nothing is watching.
SHADOW_DECOY_HOST=status.shadow-decoy.test
# Workspace-relative files whose bytes the broker refuses to let leave, under every transform it
# knows (literal, whitespace-stripped, JSON-escaped, URL-encoded, base64 at all three alignments,
# hex).
SHADOW_PROTECTED_FILES=customers.jsonl,.env
SHADOW_BROKER_IMAGE=node:22-bookworm-slim
SHADOW_BROKER_PROXY_PORT=3128
SHADOW_BROKER_MODEL_PORT=8317
# One codex-home per agent, sealed with the turn, so a discarded turn is forgotten by the model and
# no turn can write what every other agent reads next. Turning this off restores the stock kit's
# single shared read-write mount.
SHADOW_CODEX_HOME_PER_AGENT=true
# RUNTIME_PROVIDER=local-process runs Codex as a plain host process with a starting directory and
# no jail, so a turn can leave the workspace entirely and the transaction cannot contain it. The
# runner factory refuses that combination unless this is set to 1, and when it is, every single
# turn is journaled `confinement: "none"` rather than the fact being mentioned once at boot.
#
# It ships COMMENTED OUT on purpose. This file is copied verbatim to .env by
# scripts/bootstrap-local.sh, so shipping it set meant the one deliberate opt-in to running with no
# jail was already taken for anybody who followed our own setup instructions, which is the opposite
# of a deliberate opt-in. RUNTIME_PROVIDER now defaults to container, so the ordinary path does not
# need this at all. Uncomment it only if you are knowingly running unconfined and accept that every
# turn is recorded confinement: "none".
# SHADOW_ALLOW_UNCONFINED=1

# --- Audit ledger (journal cryptography) ------------------------------------
# The journal keys live OUTSIDE the data directory and outside anything a turn's
# container mounts. Leave these unset and the server creates them at 0600 under
# ~/.shadow-commit on first run; set SHADOW_JOURNAL_KEY when a secret manager
# injects the key instead. Never commit a key.
# SHADOW_JOURNAL_KEY=
# SHADOW_JOURNAL_KEY_FILE=~/.shadow-commit/journal.key
# SHADOW_COMMIT_HOME=~/.shadow-commit
# Where the Ed25519 public key is published. Point this at a path git tracks so
# an auditor has the key before the first run rather than after it.
# SHADOW_JOURNAL_PUBKEY_FILE=
# Records between signed checkpoints. A checkpoint is also written at shutdown.
# SHADOW_CHECKPOINT_EVERY=64
# Where checkpoint heads are anchored: any of git, rekor, ots, or none. Only git
# is on by default, because the other two are network calls to public logs and a
# platform should decide to publish its heads rather than discover that it does.
# SHADOW_ANCHORS=git
# SHADOW_ANCHOR_GIT_NOTES=1
# SHADOW_REKOR_URL=https://rekor.sigstore.dev
# SHADOW_OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org
